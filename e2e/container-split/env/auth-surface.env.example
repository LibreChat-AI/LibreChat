# auth-surface.env.example — Container 1's per-service differences ONLY.
#
# Template. run.mjs copies it to env/auth-surface.env for a run. Loaded AFTER common.env, so this
# file carries only what differs from the API_Container per scripts/container-split/env-matrix.md.
# Read that matrix for which settings differ and why; this file records the auth-surface values.
#
# MONGO_URI is NOT here — compose.harness.yml sets it via `environment:` with the Container_1_Grant
# credential and authSource=admin, so the credential comes from the generated per-run secrets, not
# from a committed file (Req 5.6). No secret value appears below.

# --- Boot posture: the auth surface boots clean under a grant that cannot bootstrap -------------
# DISABLE_STARTUP_TASKS SET (env-matrix.md, "DISABLE_STARTUP_TASKS"): suppresses seeding,
# permission derivation, migration checks, sweeps, sync, MCP init, OAuth reconnect, the RAG probe
# and search indexing, so the auth surface boots clean under the Container_1_Grant. Any non-empty
# value counts as set; "true" is explicit.
DISABLE_STARTUP_TASKS=true

# --- Writes at boot: none (env-matrix.md, "MONGO_AUTO_INDEX / MONGO_AUTO_CREATE") ---------------
# Both false because index creation and collection creation are writes, and the auth surface's
# BOOT issues none. This is a statement about boot, not the process: request-path createIndex on
# sessions, refreshtokenbridges and openidrefreshflights still runs, and the grant permits it.
MONGO_AUTO_INDEX=false
MONGO_AUTO_CREATE=false

# --- Search: disabled here (env-matrix.md, "Search and MeiliSearch") ----------------------------
# indexSync() reads all of conversations and messages at boot, both outside the auth surface's
# grant, so disabling search here is a clean-boot requirement. SEARCH=false is recorded even
# though DISABLE_STARTUP_TASKS already suppresses the sync — the two guards are independent and
# both apply.
SEARCH=false

# MEILI_HOST and MEILI_MASTER_KEY are ABSENT on the auth surface (env-matrix.md, "MEILI_HOST and
# MEILI_MASTER_KEY"). Their presence is what attaches the search plugin, whose provisioning block
# issues outbound MeiliSearch calls at model registration. Leave them unset — do NOT add them
# here. MeiliSearch is reachable from the API_Container only.
