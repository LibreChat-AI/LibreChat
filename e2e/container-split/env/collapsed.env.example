# collapsed.env.example — the single-container collapse overlay.
#
# Template. run.mjs copies it to env/collapsed.env for a collapsed run. The collapse is an
# env-and-config overlay on the SAME reused auth-surface service and the SAME image reference
# (see compose.harness.yml), not a third topology — which is what makes "no source change, no
# rebuild" a property of the compose file (Req 4.2 / PARITY-COLLAPSE-29).
#
# scripts/container-split/env-matrix.md, "Collapsing back to a single container", names exactly
# three levers this overlay must move. Nothing else belongs here. Read that section for why.
#
#   1. unset DISABLE_STARTUP_TASKS  — the single container owns all startup work again
#   2. restore MONGO_AUTO_INDEX and MONGO_AUTO_CREATE
#   3. re-enable search
#
# ...plus the full-access MongoDB credential — the Container_2_Grant MONGO_URI — since one
# container now reaches the whole database.

# --- Lever 1: startup tasks back ON -------------------------------------------------------------
# env-matrix.md: "unset DISABLE_STARTUP_TASKS". The overlay explicitly clears it to empty so the
# reused auth-surface service, which sets it in auth-surface.env, runs startup tasks again. An
# empty value is unset for this flag's purpose (any non-empty value would count as set).
DISABLE_STARTUP_TASKS=

# --- Lever 2: index/collection auto-build restored ----------------------------------------------
# env-matrix.md: "restore MONGO_AUTO_INDEX and MONGO_AUTO_CREATE".
MONGO_AUTO_INDEX=true
MONGO_AUTO_CREATE=true

# --- Lever 3: search re-enabled -----------------------------------------------------------------
# env-matrix.md: "re-enable search if wanted". The collapsed container attaches the search plugin,
# so it needs the MeiliSearch connection the auth-surface env omits. MEILI_MASTER_KEY is
# GENERATED_PER_RUN by run.mjs; the placeholder is a non-secret marker (Req 5.6).
SEARCH=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=GENERATED_PER_RUN

# --- Full-access credential: the Container_2_Grant MONGO_URI ------------------------------------
# env-matrix.md: "the MongoDB credential supplied — the full-access one". The reused auth-surface
# service otherwise carries the Container_1_Grant; this overlay supplies the Container_2_Grant so
# the single container reaches the whole database. authSource=admin as for every credential
# (Req 2.5). The credential is GENERATED_PER_RUN — run.mjs writes the resolved URI with the real
# API_MONGO_USERNAME/API_MONGO_PASSWORD; the placeholders below are non-secret markers (Req 5.6).
MONGO_URI=mongodb://GENERATED_PER_RUN:GENERATED_PER_RUN@mongodb:27017/GENERATED_PER_RUN?authSource=admin
