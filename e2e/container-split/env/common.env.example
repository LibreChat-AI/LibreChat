# common.env.example — the identity floor for BOTH containers (Auth_Surface and API_Container).
#
# This is the template. run.mjs copies it to env/common.env and fills in the GENERATED_PER_RUN
# secrets with crypto.randomBytes values before bring-up. No secret value is committed (Req 5.6);
# the placeholders below are deliberately non-secret markers.
#
# Both services list this file FIRST in their env_file (see compose.harness.yml), so everything
# here resolves identically on both — that structural load order is what makes the "identical"
# rows of scripts/container-split/env-matrix.md a property of the topology rather than a thing to
# remember. Per-service files (auth-surface.env, api-container.env) carry ONLY what differs.
#
# scripts/container-split/env-matrix.md is the authority on which settings must be identical and
# which differ. This file records the values; it does not restate the matrix. Read the matrix's
# table for the reasoning behind each row.

# --- Encryption key: identical on both (env-matrix.md, "CREDS_KEY") ---------------------------
# The auth surface decrypts stored TOTP secrets during two-factor verification, so it cannot be
# withheld from the anonymous-facing container. 32 bytes hex; run.mjs generates it per run.
CREDS_KEY=GENERATED_PER_RUN
# 16 bytes hex. env-matrix.md names CREDS_KEY in the identical set; CREDS_IV is its paired IV and
# must match for the same reason. run.mjs generates it per run.
CREDS_IV=GENERATED_PER_RUN

# --- JWT secrets: identical on both (env-matrix.md, "JWT_SECRET, JWT_REFRESH_SECRET") ---------
# The auth surface issues; the API container re-validates every forwarded bearer through
# requireJwtAuth. Divergence breaks validation of tokens the other container issued.
JWT_SECRET=GENERATED_PER_RUN
JWT_REFRESH_SECRET=GENERATED_PER_RUN

# --- OpenID role sync: identical on both (env-matrix.md, "OPENID_ROLE_SYNC_* (all six)") ------
# Role sync runs on both (login on the auth surface, remoteAgentAuth on the API container).
# Divergence flaps user.role on alternating requests with no error surfaced. Any value works so
# long as it is the SAME value on both; these examples reproduce today's default behavior.
OPENID_ROLE_SYNC_ENABLED=false
OPENID_ROLE_SYNC_API_ENABLED=false
OPENID_ROLE_SYNC_SOURCE=
OPENID_ROLE_SYNC_CLAIM=
OPENID_ROLE_SYNC_ROLE_PRIORITY=
OPENID_ROLE_SYNC_FALLBACK_ROLE=

# --- Entra people search: identical on both (env-matrix.md, "USE_ENTRA_ID_FOR_PEOPLE_SEARCH") -
# Enabled with OPENID_REUSE_TOKENS on an openid provider, it is what makes the auth surface's
# groups grant require write. Must resolve to the same value on both; default off here.
USE_ENTRA_ID_FOR_PEOPLE_SEARCH=false

# --- MCP OAuth flow window: identical on both (env-matrix.md, "The OAuth flow window") --------
# MCP_OAUTH_HANDLING_TIMEOUT and MCP_OAUTH_FLOW_TTL stay ABSENT on both, which resolves the
# application defaults 600000 and 900000 — the same window on both containers, which is all the
# matrix row asks for. They are NOT set empty here, and setting them empty is FATAL rather than
# untidy: docker's env_file turns `KEY=` into an empty STRING, not an unset variable, and
# packages/api/src/mcp/mcpConfig.ts reads them as `math(process.env.KEY ?? <default>)`. `??` falls
# back on null/undefined only, so the empty string reaches math() with NO fallbackValue, its
# /^[+\-\d.\s*\/%()]+$/ validator is `+`-quantified and rejects '', and math() THROWS at module
# load — killing boot before any route mounts. That is what produced `Error: Invalid characters in
# string` and a bring-up timeout. Leave both unset; run.mjs's pre-bring-up guard refuses the run
# if either (or any sibling MCP key mcpConfig.ts parses the same way) comes back set-but-empty.

# --- Shared surface, kept identical (env-matrix.md, "Why each one must be identical") ---------
# ALLOW_SHARED_LINKS_PUBLIC absent-or-false on BOTH: anonymous share viewers 401 at the gate
# regardless, so enabling it widens the anonymous surface and buys nothing. Recorded as false so
# a comparison accounts for it rather than treating absence as unexplained.
ALLOW_SHARED_LINKS_PUBLIC=false
# FORCED_IN_MEMORY_CACHE_NAMESPACES stays ABSENT on both so each resolves the default
# CONFIG_STORE,APP_CONFIG. Presence is tested, not truthiness — so it is left unset here rather
# than set empty (an empty value is a reachable opt-out, not the default). Do not add it.

# --- Redis block: identical on both, same instance and keyspace (env-matrix.md, "Redis") ------
# Points both containers at the one harness redis service and the same keyspace. Shared Redis is
# required, as for any multi-replica deployment. No secret here; the harness redis has no auth.
USE_REDIS=true
REDIS_URI=redis://redis:6379
REDIS_KEY_PREFIX=harness

# --- App server basics common to both -----------------------------------------------------------
# Both containers ARE the same image and serve on the same internal port; the compose healthchecks
# and the loopback observation plane assume 3080.
HOST=0.0.0.0
PORT=3080
NODE_ENV=production
# --- Login limiter headroom and redirect origin: identical on both ------------------------------
# These four belong here rather than in a per-service file because both containers ARE the same
# image and must resolve them identically, and because the collapsed profile reuses the same
# service — a per-service spelling would give the collapsed run a different limiter ceiling than
# the split run, which is exactly the kind of difference the harness exists to rule out.
#
# WHY THE HEADROOM. api/server/middleware/limiters/loginLimiter.js is ONE express-rate-limit
# instance keyed by client IP (`removePorts`), reading `const { LOGIN_WINDOW = 5, LOGIN_MAX = 7 } =
# process.env`. That single key guards the six `/oauth/<provider>` paths, `/api/auth/login` and
# `/api/admin/login/local` — eight exercises — PLUS the `Session_Fixture` login mint, a ninth
# request through the same key. Nine requests against a default of seven means the exercises past
# the seventh stop answering on their own merits and start answering the limiter's. Observed in a
# live run: `/api/admin/login` answered 429 instead of its recorded 403, and bare `/oauth` answered
# 302 with `Location: undefined/login?redirect=false&error=auth_rate_limited`, which the ingress
# client FOLLOWED to a non-allowlisted path — so `ROUTE-ALLOW-27` read the FINAL hop's
# `X-Harness-Upstream: api-container` and failed on a path Caddy had in fact routed to
# `auth-surface` correctly. The limiter was reporting on the harness, not the topology.
#
# There is NO disable flag: the limiter is mounted unconditionally on those routers, so raising the
# ceiling is the only lever available. This is not a workaround for a check, it is removing a
# harness artifact from the measurement. Nothing asserts on limiter violations, and `bans` writes
# are decided directly by Layer A's `GRANT-ALLOW-WRITE-05` rather than by provoking the limiter, so
# a higher ceiling weakens no check in the catalog.
#
# LOGIN_MAX MUST ALWAYS CARRY A REAL NUMBER. `LOGIN_MAX=` (empty) is FATAL, not untidy, and it is
# the same hazard class as the MCP keys the MATH_PARSED_ENV_KEYS guard above documents: docker's
# env_file turns `KEY=` into an empty STRING, `max` is assigned the raw env string, and '' coerces
# to 0 — which rate-limits the FIRST request and is strictly worse than the default of seven. Do
# not "unset" these by emptying them; delete the line or give it a number.
LOGIN_WINDOW=5
LOGIN_MAX=1000000

# WHY DOMAIN_CLIENT/DOMAIN_SERVER. Both were unset, so `redirectOAuthFailure` built a `Location`
# header of literally `undefined/login?...` — the malformed redirect above. They are set to the
# ingress origin, http://127.0.0.1:8080, which is run.mjs's `INGRESS_BASE_URL` and the
# `127.0.0.1:8080:80` publish in compose.harness.yml, so a redirect the application emits points at
# the reality of the test topology instead of at `undefined`.
DOMAIN_CLIENT=http://127.0.0.1:8080
DOMAIN_SERVER=http://127.0.0.1:8080
