# api-container.env.example — Container 2's per-service differences ONLY.
#
# Template. run.mjs copies it to env/api-container.env for a run. Loaded AFTER common.env, so this
# file carries only what differs from the Auth_Surface per scripts/container-split/env-matrix.md.
# Read that matrix for which settings differ and why; this file records the API-container values.
#
# MONGO_URI is NOT here — compose.harness.yml sets it via `environment:` with the Container_2_Grant
# credential and authSource=admin. The credential comes from the generated per-run secrets, not
# from a committed file (Req 5.6). No secret value appears below.

# --- Boot posture: the API container owns the bootstrap work -----------------------------------
# DISABLE_STARTUP_TASKS UNSET on the API container (env-matrix.md, "DISABLE_STARTUP_TASKS"): it is
# the container that runs seeding, permission derivation, migrations, sweeps and sync. Left unset
# by NOT declaring it here — common.env does not set it either, so it resolves absent. Do not add
# it.

# --- Writes allowed (env-matrix.md, "MONGO_AUTO_INDEX / MONGO_AUTO_CREATE") ---------------------
# Both may stay on for the API container, whose autoIndex builds the authtokens TTL index on
# expiresAt alongside every other index in the schema set. Recorded true to make the difference
# from the auth surface explicit rather than relying on absence.
MONGO_AUTO_INDEX=true
MONGO_AUTO_CREATE=true

# --- Search: enabled here (env-matrix.md, "Search and MeiliSearch") -----------------------------
# Search is on for the API container, which owns indexSync(). MeiliSearch is provisioned for this
# container and no other.
SEARCH=true

# MEILI_HOST and MEILI_MASTER_KEY are PRESENT here (env-matrix.md): the search plugin attaches on
# this container. MEILI_HOST points at the harness meilisearch service; MEILI_MASTER_KEY is
# GENERATED_PER_RUN by run.mjs and written into env/api-container.env — the placeholder below is a
# non-secret marker, never a committed key (Req 5.6).
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=GENERATED_PER_RUN

# --- RAG (env-matrix.md, "RAG_API_URL", may differ) --------------------------------------------
# RAG_API_URL backs file upload and file search, both API-container paths. No path routed to the
# auth surface uses RAG, so it is absent there. Set here if a run exercises RAG; left unset by
# default since the harness does not stand up a RAG service.
# RAG_API_URL=http://rag_api:8000
