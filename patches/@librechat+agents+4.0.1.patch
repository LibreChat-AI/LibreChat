+import { NativeMediaError } from "../errors.mjs";
+import { AIMessage, HumanMessage } from "@langchain/core/messages";
+import { v4 } from "uuid";
+//#region src/llm/google/native.ts
+var NativeMediaSession = class {
+	port;
+	model;
+	signal;
+	finished = false;
+	storageFailure = false;
+	receivedContent = false;
+	imageAdmission = false;
+	usage;
+	providerOutcome;
+	modelRunId;
+	constructor(port, model, modelRunId, signal) {
+		this.port = port;
+		this.model = model;
+		this.signal = signal;
+		this.modelRunId = modelRunId ?? v4();
+	}
+	async start() {
+		const admitted = await this.port?.start({
+			modelRunId: this.modelRunId,
+			model: this.model,
+			signal: this.signal
+		});
+		this.imageAdmission = admitted?.responseModalities.some((modality) => modality.toUpperCase() === "IMAGE") === true;
+		return admitted;
