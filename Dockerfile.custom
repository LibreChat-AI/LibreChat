# v0.8.7 - Custom build with MCP servers

# Base node image
FROM node:24.16.0-alpine AS node

RUN apk upgrade --no-cache
RUN apk add --no-cache jemalloc
RUN apk add --no-cache python3 py3-pip uv

# Set environment variable to use jemalloc
ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2

# Add `uv` for extended MCP support
COPY --from=ghcr.io/astral-sh/uv:0.9.5-python3.12-alpine /usr/local/bin/uv /usr/local/bin/uvx /bin/
RUN uv --version

# Set configurable max-old-space-size with default
ARG NODE_MAX_OLD_SPACE_SIZE=6144
ARG NPM_CI_TIMEOUT_SECONDS=1500
ARG NPM_CI_ATTEMPTS=2

RUN mkdir -p /app && chown node:node /app
WORKDIR /app

USER node

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node api/package.json ./api/package.json
COPY --chown=node:node client/package.json ./client/package.json
COPY --chown=node:node packages/data-provider/package.json ./packages/data-provider/package.json
COPY --chown=node:node packages/data-schemas/package.json ./packages/data-schemas/package.json
COPY --chown=node:node packages/api/package.json ./packages/api/package.json

RUN \
    # Allow mounting of these files, which have no default
    touch .env ; \
    # Create directories for the volumes to inherit the correct permissions
    mkdir -p /app/client/public/images /app/logs /app/uploads /app/skill ; \
    npm config set fetch-retry-maxtimeout 600000 ; \
    npm config set fetch-retries 5 ; \
    npm config set fetch-retry-mintimeout 15000 ; \
    attempt=1 ; \
    until timeout "$NPM_CI_TIMEOUT_SECONDS" npm ci --no-audit ; do \
        status=$? ; \
        if [ "$attempt" -ge "$NPM_CI_ATTEMPTS" ]; then \
            exit "$status" ; \
        fi ; \
        echo "npm ci --no-audit failed with exit code $status; retrying attempt $((attempt + 1))/$NPM_CI_ATTEMPTS" ; \
        attempt=$((attempt + 1)) ; \
        npm cache clean --force || true ; \
        sleep 10 ; \
    done

COPY --chown=node:node . .

RUN \
    # React client build with configurable memory
    NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" npm run frontend; \
    npm prune --production; \
    npm cache clean --force

# Optional build metadata surfaced in Settings -> About for support triage.
ARG BUILD_COMMIT=
ARG BUILD_BRANCH=
ARG BUILD_DATE=
ENV BUILD_COMMIT=${BUILD_COMMIT}
ENV BUILD_BRANCH=${BUILD_BRANCH}
ENV BUILD_DATE=${BUILD_DATE}

# ===== CUSTOM: Add MCP servers =====
USER root

# Install system dependencies for PDF rendering (file-reader MCP)
RUN apk add --no-cache poppler-utils

# Copy MCP servers
COPY mcp-servers/image/package.json /app/mcp-servers/image/package.json
COPY mcp-servers/image/index.js /app/mcp-servers/image/index.js
COPY mcp-servers/image-openrouter/package.json /app/mcp-servers/image-openrouter/package.json
COPY mcp-servers/image-openrouter/index.js /app/mcp-servers/image-openrouter/index.js
COPY mcp-servers/video/package.json /app/mcp-servers/video/package.json
COPY mcp-servers/video/index.js /app/mcp-servers/video/index.js
COPY mcp-servers/video-openrouter/package.json /app/mcp-servers/video-openrouter/package.json
COPY mcp-servers/video-openrouter/index.js /app/mcp-servers/video-openrouter/index.js
COPY mcp-servers/document-generator/package.json /app/mcp-servers/document-generator/package.json
COPY mcp-servers/document-generator/index.js /app/mcp-servers/document-generator/index.js
COPY mcp-servers/document-generator/generators /app/mcp-servers/document-generator/generators
COPY mcp-servers/file-reader/package.json /app/mcp-servers/file-reader/package.json
COPY mcp-servers/file-reader/index.js /app/mcp-servers/file-reader/index.js

# Install MCP server dependencies
RUN cd /app/mcp-servers/image && npm install --production
RUN cd /app/mcp-servers/image-openrouter && npm install --production
RUN cd /app/mcp-servers/video && npm install --production
RUN cd /app/mcp-servers/video-openrouter && npm install --production
RUN cd /app/mcp-servers/document-generator && npm install --production
RUN cd /app/mcp-servers/file-reader && npm install --production

# Return to node user
USER node
# ===== END CUSTOM =====

# Node API setup
EXPOSE 3080
ENV HOST=0.0.0.0
CMD ["npm", "run", "backend"]
