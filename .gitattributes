.husky/* text eol=lf
*.sh text eol=lf

# Preserve tracked dotenv templates and the vendor protocol checksum.
.env.example text eol=lf
.env.test.example text eol=lf
/vendor/code/browser-enrollment-protocol.ts text eol=lf
