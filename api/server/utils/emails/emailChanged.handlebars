<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Email address changed</title>
  </head>
  <body style='margin:0;background:#f5f5f5;font-family:Arial,sans-serif;color:#1f2937'>
    <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
      <tr>
        <td align='center' style='padding:32px 16px'>
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='max-width:560px;background:#ffffff;border-radius:12px'
          >
            <tr>
              <td style='padding:32px'>
                <h1 style='margin:0 0 20px;font-size:24px'>Email address changed</h1>
                <p>Hello {{name}},</p>
                <p>The email address for your {{appName}} account was changed successfully.</p>
                <p>
                  <strong>Previous email:</strong>
                  {{oldEmail}}<br />
                  <strong>New email:</strong>
                  {{newEmail}}<br />
                  <strong>Time:</strong>
                  {{changedAt}}<br />
                  <strong>IP address:</strong>
                  {{ip}}
                </p>
                <p>
                  If you did not make this change, contact your administrator immediately and secure
                  your account.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>