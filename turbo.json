{
  "$schema": "https://v2-10-5.turborepo.dev/schema.json",
  "globalDependencies": ["package-lock.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/__tests__/**",
        "!src/**/__mocks__/**",
        "!src/**/*.test.*",
        "!src/**/*.spec.*",
        "scripts/**",
        "tsdown.config.mjs",
        "tsconfig.json",
        "tsconfig.build.json",
        "vite.config.ts",
        "index.html",
        "postcss.config.*",
        "tailwind.config.*",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "test/.env.test", "$TURBO_ROOT$/config/jest*.{js,cjs}"],
      "outputs": ["coverage/**"],
      "env": [
        "CI",
        "COVERAGE",
        "RUN_*_LIVE_TESTS",
        "LIBRECHAT_CODE_TEST_*",
        "GRAPH_SUBAGENT_*",
        "ANTHROPIC_USAGE_LIVE_MODEL",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
      ],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "@librechat/backend#test:ci": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "test/.env.test",
        "$TURBO_ROOT$/config/jest*.{js,cjs}",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/config/connect.js",
        "$TURBO_ROOT$/config/migrate-orphaned-agent-files.js"
      ],
      "outputs": ["coverage/**"],
      "env": [
        "CI",
        "COVERAGE",
        "RUN_*_LIVE_TESTS",
        "LIBRECHAT_CODE_TEST_*",
        "GRAPH_SUBAGENT_*",
        "ANTHROPIC_USAGE_LIVE_MODEL",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
      ],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "@librechat/data-schemas#test:ci": {
      "dependsOn": ["^build", "librechat-data-provider#build"],
      "inputs": ["$TURBO_DEFAULT$", "test/.env.test", "$TURBO_ROOT$/config/jest*.{js,cjs}"],
      "outputs": ["coverage/**"],
      "env": [
        "CI",
        "COVERAGE",
        "RUN_*_LIVE_TESTS",
        "LIBRECHAT_CODE_TEST_*",
        "GRAPH_SUBAGENT_*",
        "ANTHROPIC_USAGE_LIVE_MODEL",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
      ],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "@librechat/api#test:ci": {
      "dependsOn": ["^build", "librechat-data-provider#build", "@librechat/data-schemas#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "test/.env.test",
        "$TURBO_ROOT$/config/jest*.{js,cjs}",
        "$TURBO_ROOT$/client/src/components/Chat/Messages/Content/Parts/handle.ts",
        "$TURBO_ROOT$/client/src/components/Chat/approval/preview.ts"
      ],
      "outputs": ["coverage/**"],
      "env": [
        "CI",
        "COVERAGE",
        "RUN_*_LIVE_TESTS",
        "LIBRECHAT_CODE_TEST_*",
        "GRAPH_SUBAGENT_*",
        "ANTHROPIC_USAGE_LIVE_MODEL",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
      ],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "@librechat/data-schemas#build": {
      "dependsOn": ["^build", "librechat-data-provider#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "outputs": ["dist/**"]
    },
    "@librechat/api#build": {
      "dependsOn": ["^build", "librechat-data-provider#build", "@librechat/data-schemas#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "outputs": ["dist/**"]
    },
    "@librechat/client#build": {
      "dependsOn": ["^build", "librechat-data-provider#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "outputs": ["dist/**"]
    }
  }
}
