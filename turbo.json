{
  "$schema": "https://v2-10-5.turborepo.dev/schema.json",
  "globalDependencies": ["package-lock.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/__tests__/**",
        "!src/**/__mocks__/**",
        "!src/**/*.test.*",
        "!src/**/*.spec.*",
        "scripts/**",
        "tsdown.config.mjs",
        "tsconfig.json",
        "tsconfig.build.json",
        "vite.config.ts",
        "index.html",
        "postcss.config.*",
        "tailwind.config.*",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@librechat/data-schemas#test:ci": {
      "dependsOn": ["^build", "librechat-data-provider#build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@librechat/api#test:ci": {
      "dependsOn": ["^build", "librechat-data-provider#build", "@librechat/data-schemas#build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@librechat/data-schemas#build": {
      "dependsOn": ["^build", "librechat-data-provider#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "outputs": ["dist/**"]
    },
    "@librechat/api#build": {
      "dependsOn": ["^build", "librechat-data-provider#build", "@librechat/data-schemas#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "outputs": ["dist/**"]
    },
    "@librechat/client#build": {
      "dependsOn": ["^build", "librechat-data-provider#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "VITE_ENABLE_LOGGER", "VITE_LOGGER_FILTER"]
    }
  }
}
